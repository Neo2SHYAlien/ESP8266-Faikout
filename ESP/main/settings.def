bit	dump									// Dump protocol on MQTT for each message
bit	debug				.live=1 .hide=1			// Debug - logs summary of status responses
bit	s21.extra			.live=1					// Sends extra S21 messages, usually used with dump or debug
u8	s21.tries	10		.live=1					// Repeat attempts at S21 controls
bit	debughex			.live=1					// Debug in hex
bit	snoop									// Listen only (for debugging)
bit	livestatus			.live=1					// Send status messages in real time
bit	fixstatus								// Send status as fixed values not array

bit	web.control	1							// Web based controls
bit	web.settings	1							// Web based settings

s	model									// Set model name manually
s	region		eu							// Region (legacy URLs)

bit	fahrenheit			.live=1					// Web shows Fahrenheit

bit	no.s21				.live=1	.fix=1				// Do not try S21 protocol
bit	no.x50a				.live=1	.fix=1				// Do not try X50A protocol
bit	no.cnwired	0		.live=1	.fix=1				// Do not try CN_WIRED protocol
bit	no.as		1		.live=1	.fix=1				// Do not try (experimental) Altherma_S protocol
bit	txinvert		    .fix=1 .old="swaptx"	    // Invert Tx line
bit	rxinvert		    .fix=1 .old="swaprx"	    // Invert Rx line

bit	no.demand								// Disable demand control
bit	no.auto									// Unit does not have auto mode
bit	no.econo								// Unit does not have econo mode
bit	no.swingv				.old="noswingw",				// Unit does not have swing (V)
bit 	no.swingh								// Unit does not have swing (H)
bit	no.comfort								// Unit does not have comfort mode
bit	no.streamer								// Unit does not have streamer mode
bit	no.sleep								// Unit does not have sleep mode
bit	no.powerful								// Unit does not have powerful mode
bit	no.sensor								// Unit does not have sensor mode
bit	no.quiet								// Unit does not have quiet mode
bit	no.led		1							// Unit does not have LED control
bit	no.hourly			.live=1						// Do not do hourly S21 poll (DH)
bit	no.humidify	1							// Unit does not have humidifier
bit	no.flap									// Unit does not have flap mode
bit	no.antifreeze							// Unit does not have antifreeze mode
bit	no.humidity								// Unit does not have humidity

bit	no.faikoutauto			.live=1 .old="nofaikinauto",	// Do not show faikin auto controls (unless already set up and no password)
bit	no.hvacaction	1							// Do not track/report hvac_action for Faikin auto mode in HA
bit	no.fanauto								// Do not control fan in faikin auto mode
bit	no.homepreset								// Do not include a home in HA preset list
bit	no.icons			.live=1					// Do not show icons on web UI

bit	udp.discovery			.old="udp_discovery",		// Enable Daikin BRP-compatible UDP discovery

bit	ha.enable	1		.old="ha"				// Home Assistant
bit	ha.switches								// Set additional HA switches
bit	ha.fanrpm								// Use RPM not Hz for HA fan speed
bit	ha.comprpm								// Use RPM not Hz for HA comp speed
bit	ha.1c									// Force 1C steps in HA temp setting
bit	ha.ram									// Log memory usage
s	ha.domain	"local"							// Local domain for HA links (blank for IP)

#ifdef CONFIG_BT_NIMBLE_ENABLED
bit	ble									// Enable BLE
#endif

enum	fantype				.enums="Default,5 level+auto,3 level,3 level+auto"	.old="fanstep"	// Fan type override

bit	lockmode								// Lock mode in Faikin auto

u8	protocol			.hide=1					// Internal protocol as found, saved when found, can be used with protofix
bit	protofix			.hide=1					// Protofix forces no change, use nos21, nox50a, etc instead maybe

u32	reporting	60							// Status report period (s)

u8	uart		0		.fix=1					// UART number

u8	thermref	50		.live=1					// Percentage inlet rather than home temp used by your aircon

u8	switchtemp	0.5		.live=1	.decimal=1 .unit="℃", .old="switch10",	// Increase max (heating) or decrease min (cooling)
u8	pushtemp	0.1		.live=1	.decimal=1 .unit="℃", .old="push10",	// Increase min (heating) or decrease max (cooling)

s8	cool.over	6		.live=1 .unit="℃"			// For cooling, push (decrease) target sent to aircon by this from min to force cooling before reaching target
u8	cool.back	6		.live=1 .unit="℃"			// For cooling, pull (increase) target sent to aircon by this from max to stop cooling after reaching target

s8	heat.over	6		.live=1 .unit="℃"			// For heating, push (increase) target sent to aircon by this from max to force heating before reaching target
u8	heat.back	6		.live=1 .unit="℃"			// For heating, pull (decrease) target sent to aircon by this from min to stop heating after reaching target

u8	fanrun				.live=1 .unit="min"			// Auto run fan after cool/dry

s8	min.outside	-100		.live=1 .unit="℃"			// Lowest allowed outside temp allowed for operation (if known)

s8	frosttemp	-100		.live=1 .unit="℃"			// Frost protect (below this, turn on hot regardless)

bit	temp.track	0		.live=1					// Set target temp based on Daikin measured temp not required target
bit	temp.adjust	1		.live=1					// Adjust target temp allowing for different Daikin measure to external measure
u16	temp.noflap	0		.live=1 .unit="s"			// Min time between target temp changes (seconds)

bit	auto.e		1		.live=1					// Enable auto time and power operations
u16	auto.0				.live=1					// HHMM format turn off time
u16	auto.1				.live=1					// HHMM format turn on time
u16	auto.t				.live=1	.decimal=1			// Faikin auto target temperature
u8	auto.r				.live=1	.decimal=1			// Faikin auto margin either side of autot
bit	auto.p				.live=1					// Enable auto power on/off
#ifdef CONFIG_BT_NIMBLE_ENABLED
s	auto.b				.live=1					// BLE sensor ID
#endif
u8	auto.fmax	5		.live=1	.old="fmaxauto"			// Max fan setting when starting heat/cool way off from target
u8	auto.ptemp	0.5		.live=1	.decimal=1	.old="autop10"	// Auto power on/off by temperature deviation by this amount
bit	auto.lcontrol	0		.live=1					// Auto toggle on/off LED based on current HVAC action

bit	thermostat			.live=1					// Faikin auto simple thermostat mode (heat to max, cool to min)
s	auto.topic								// Topic to follow for reference temperature for Faikin auto
s	auto.payload								// JSON field in payload of above topic for reference temp


u8	t.min		16		.live=1					// Min temp setting of system
u8	t.coolmin	16		.live=1					// Min temp setting for Faikin auto when cooling
u8	t.max		32		.live=1					// Max temp setting of system
u8	t.heatmax	32		.live=1					// Max temp setting for Faikin auto when heating
u32	t.predicts	30		.unit="s"				// Temp prediction sample time
u32	t.predictt	120		.unit="s"				// Temp prediction total time factor
u32	t.sample	900		.unit="s"				// Sample period for making adjustments
u32	t.control	600		.unit="s"					// Control messages timeout
